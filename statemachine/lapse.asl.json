{
  "Comment": "Lapse \u2014 Step Functions Standard scheduler and human-in-the-loop reminder workflow",
  "StartAt": "ExtractDetails",
  "States": {
    "ExtractDetails": {
      "Type": "Task",
      "Resource": "${ExtractDocumentFunctionArn}",
      "ResultPath": "$.doc",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "HasExpiryDate"
    },
    "HasExpiryDate": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.doc.found",
          "BooleanEquals": false,
          "Next": "EndNeedsDate"
        }
      ],
      "Default": "SaveActiveItem"
    },
    "EndNeedsDate": {
      "Type": "Succeed"
    },
    "SaveActiveItem": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('USER#{}', $.doc.email)"
          },
          "SK": {
            "S.$": "States.Format('ITEM#{}', $.doc.itemId)"
          }
        },
        "UpdateExpression": "SET itemId = :id, email = :em, #n = :nm, #t = :tp, provider = :pr, expiryDate = :ex, s3Key = :sk, #st = :st, executionArn = :ea, followUpCount = :fc, leadDays = :ld, updatedAt = :ua, createdAt = if_not_exists(createdAt, :ua)",
        "ExpressionAttributeNames": {
          "#n": "name",
          "#t": "type",
          "#st": "status"
        },
        "ExpressionAttributeValues": {
          ":id": {
            "S.$": "$.doc.itemId"
          },
          ":em": {
            "S.$": "$.doc.email"
          },
          ":nm": {
            "S.$": "$.doc.name"
          },
          ":tp": {
            "S.$": "$.doc.type"
          },
          ":pr": {
            "S.$": "$.doc.provider"
          },
          ":ex": {
            "S.$": "$.doc.expiryDate"
          },
          ":sk": {
            "S.$": "$.doc.s3Key"
          },
          ":st": {
            "S": "ACTIVE"
          },
          ":ea": {
            "S.$": "$$.Execution.Id"
          },
          ":fc": {
            "N.$": "States.Format('{}', $.doc.followUpCount)"
          },
          ":ua": {
            "S.$": "$$.State.EnteredTime"
          },
          ":ld": {
            "N.$": "States.Format('{}', $.doc.leadDays)"
          }
        }
      },
      "ResultPath": null,
      "Next": "RecordExecutionId"
    },
    "RecordExecutionId": {
      "Type": "Pass",
      "Comment": "This execution owns the item only while item.executionArn matches; older or duplicate executions end at their next status check.",
      "Parameters": {
        "id.$": "$$.Execution.Id"
      },
      "ResultPath": "$.self",
      "Next": "SetInitialMode"
    },
    "SetInitialMode": {
      "Type": "Pass",
      "Result": "initial",
      "ResultPath": "$.mode",
      "Next": "ComputeReminder"
    },
    "ComputeReminder": {
      "Type": "Task",
      "Resource": "${ComputeReminderFunctionArn}",
      "Parameters": {
        "expiryDate.$": "$.doc.expiryDate",
        "mode.$": "$.mode",
        "executionStartTime.$": "$$.Execution.StartTime",
        "leadDays.$": "$.doc.leadDays"
      },
      "ResultPath": "$.schedule",
      "Next": "WaitUntilReminder"
    },
    "WaitUntilReminder": {
      "Type": "Wait",
      "SecondsPath": "$.schedule.waitSeconds",
      "Next": "CheckItemStatus"
    },
    "CheckItemStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('USER#{}', $.doc.email)"
          },
          "SK": {
            "S.$": "States.Format('ITEM#{}', $.doc.itemId)"
          }
        }
      },
      "ResultPath": "$.currentItem",
      "Next": "IsItemStillActive"
    },
    "IsItemStillActive": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.currentItem.Item.executionArn.S",
          "IsPresent": false,
          "Next": "EndStopped"
        },
        {
          "And": [
            {
              "Variable": "$.currentItem.Item.status.S",
              "StringEquals": "ACTIVE"
            },
            {
              "Variable": "$.currentItem.Item.executionArn.S",
              "StringEqualsPath": "$.self.id"
            }
          ],
          "Next": "CheckContinueAsNew"
        }
      ],
      "Default": "EndStopped"
    },
    "EndStopped": {
      "Type": "Succeed"
    },
    "CheckContinueAsNew": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.schedule.continueAsNew",
          "BooleanEquals": true,
          "Next": "ContinueAsNew"
        }
      ],
      "Default": "SendReminderAndWait"
    },
    "ContinueAsNew": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Input": {
          "skipExtract": true,
          "itemId.$": "$.doc.itemId",
          "email.$": "$.doc.email",
          "name.$": "$.doc.name",
          "type.$": "$.doc.type",
          "provider.$": "$.doc.provider",
          "expiryDate.$": "$.doc.expiryDate",
          "s3Key.$": "$.doc.s3Key",
          "followUpCount.$": "$.doc.followUpCount",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id",
          "leadDays.$": "$.doc.leadDays"
        }
      },
      "End": true
    },
    "SendReminderAndWait": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSecondsPath": "$.schedule.responseTimeoutSeconds",
      "Parameters": {
        "FunctionName": "${SendReminderFunctionArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "email.$": "$.doc.email",
          "itemId.$": "$.doc.itemId",
          "name.$": "$.doc.name",
          "provider.$": "$.doc.provider",
          "expiryDate.$": "$.doc.expiryDate",
          "followUpCount.$": "$.doc.followUpCount",
          "type.$": "$.doc.type"
        }
      },
      "ResultPath": "$.userResponse",
      "Retry": [
        {
          "Comment": "SES throttling or transient Lambda errors; States.TaskFailed never matches States.Timeout.",
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.timeoutError",
          "Next": "IncrementFollowUp"
        },
        {
          "Comment": "Reminder could not be sent even after retries: count it as a missed reminder so the item still ends (IGNORED) instead of failing the execution.",
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.reminderError",
          "Next": "IncrementFollowUp"
        }
      ],
      "Next": "BranchOnUserResponse"
    },
    "IncrementFollowUp": {
      "Type": "Pass",
      "Parameters": {
        "found.$": "$.doc.found",
        "itemId.$": "$.doc.itemId",
        "email.$": "$.doc.email",
        "name.$": "$.doc.name",
        "type.$": "$.doc.type",
        "provider.$": "$.doc.provider",
        "expiryDate.$": "$.doc.expiryDate",
        "s3Key.$": "$.doc.s3Key",
        "followUpCount.$": "States.MathAdd($.doc.followUpCount, 1)",
        "leadDays.$": "$.doc.leadDays"
      },
      "ResultPath": "$.doc",
      "Next": "CheckFollowUpLimit"
    },
    "CheckFollowUpLimit": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.doc.followUpCount",
          "NumericGreaterThanEquals": 5,
          "Next": "MarkIgnored"
        }
      ],
      "Default": "SetFollowUpMode"
    },
    "SetFollowUpMode": {
      "Type": "Pass",
      "Result": "followup",
      "ResultPath": "$.mode",
      "Next": "ComputeReminder"
    },
    "MarkIgnored": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('USER#{}', $.doc.email)"
          },
          "SK": {
            "S.$": "States.Format('ITEM#{}', $.doc.itemId)"
          }
        },
        "UpdateExpression": "SET #st = :st, followUpCount = :fc, updatedAt = :ua",
        "ConditionExpression": "#st = :active AND executionArn = :me",
        "ExpressionAttributeNames": {
          "#st": "status"
        },
        "ExpressionAttributeValues": {
          ":st": {
            "S": "IGNORED"
          },
          ":fc": {
            "N.$": "States.Format('{}', $.doc.followUpCount)"
          },
          ":ua": {
            "S.$": "$$.State.EnteredTime"
          },
          ":active": {
            "S": "ACTIVE"
          },
          ":me": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "Catch": [
        {
          "Comment": "Item was stopped or taken over by a newer execution; leave it alone.",
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "ResultPath": null,
          "Next": "EndStopped"
        }
      ],
      "End": true
    },
    "BranchOnUserResponse": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.userResponse.choice",
          "StringEquals": "RENEWED_WITH_DATE",
          "Next": "RestartWithNewDate"
        },
        {
          "Variable": "$.userResponse.choice",
          "StringEquals": "RENEWED",
          "Next": "MarkRenewed"
        },
        {
          "Variable": "$.userResponse.choice",
          "StringEquals": "SNOOZE",
          "Next": "SetSnoozeMode"
        }
      ],
      "Default": "MarkRenewed"
    },
    "RestartWithNewDate": {
      "Type": "Task",
      "Comment": "Each renewal cycle gets a fresh execution so the next wait (up to ~a year) never runs into the 1-year execution limit of this one (D13, D14).",
      "Resource": "arn:aws:states:::states:startExecution",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "Input": {
          "skipExtract": true,
          "itemId.$": "$.doc.itemId",
          "email.$": "$.doc.email",
          "name.$": "$.doc.name",
          "type.$": "$.doc.type",
          "provider.$": "$.doc.provider",
          "expiryDate.$": "$.userResponse.newExpiryDate",
          "s3Key.$": "$.doc.s3Key",
          "followUpCount": 0,
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id",
          "leadDays.$": "$.doc.leadDays"
        }
      },
      "End": true
    },
    "SetSnoozeMode": {
      "Type": "Pass",
      "Result": "snooze",
      "ResultPath": "$.mode",
      "Next": "ComputeReminder"
    },
    "MarkRenewed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('USER#{}', $.doc.email)"
          },
          "SK": {
            "S.$": "States.Format('ITEM#{}', $.doc.itemId)"
          }
        },
        "UpdateExpression": "SET #st = :st, updatedAt = :ua",
        "ConditionExpression": "#st = :active AND executionArn = :me",
        "ExpressionAttributeNames": {
          "#st": "status"
        },
        "ExpressionAttributeValues": {
          ":st": {
            "S": "RENEWED"
          },
          ":ua": {
            "S.$": "$$.State.EnteredTime"
          },
          ":active": {
            "S": "ACTIVE"
          },
          ":me": {
            "S.$": "$$.Execution.Id"
          }
        }
      },
      "Catch": [
        {
          "Comment": "Item was stopped or taken over by a newer execution; leave it alone.",
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "ResultPath": null,
          "Next": "EndStopped"
        }
      ],
      "End": true
    }
  }
}
